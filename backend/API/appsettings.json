{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": ""
  },
  "Email": {
    "Host": "",
    "Username": "",
    "Password": "",
    "FromAddress": ""
  },
  "Support": {
    "Email": ""
  },
  "DataProtection": {
    "CertBase64": ""
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "Prices": {
      "Pro": "",
      "Business": "",
      "ProAnnual": "",
      "BusinessAnnual": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System": "Warning",
        "Sentinel": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sentinel-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "buffered": true,
          "flushToDiskInterval": "00:00:02",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
